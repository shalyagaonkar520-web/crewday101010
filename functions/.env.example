# ---------------------------------------------------------------------------
# CrewDay Cloud Functions — outbound email
#
# Copy to `functions/.env` (gitignored) and fill in. These values are deployed
# as the function's environment; they never reach the browser bundle.
#
# For Gmail you need an *App Password* (Google Account -> Security -> 2-Step
# Verification -> App passwords), not your normal account password.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your app password
SMTP_FROM_NAME=CrewDay

# Used to build ticket and reset links inside emails.
APP_URL=https://crewday-2657d.web.app
