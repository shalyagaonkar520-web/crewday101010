# ---------------------------------------------------------------------------
# CrewDay — Firebase Web configuration
# Copy this file to `.env.local` and fill in the values from:
#   Firebase console -> Project settings -> General -> Your apps -> Web app
#
# These values are *public by design* (they identify the project, they do not
# grant privileges). All authorisation is enforced by Firestore/Storage
# Security Rules + Cloud Functions. Never put a service-account key here.
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Web Push certificate key pair (Project settings -> Cloud Messaging -> Web Push certificates)
VITE_FIREBASE_VAPID_KEY=

# Optional: point the app at the local Firebase emulator suite
VITE_USE_FIREBASE_EMULATORS=false

# Public support address shown on the privacy policy and account-deletion pages
# (Google Play also requires one on the store listing).
VITE_SUPPORT_EMAIL=

# "true" shows the Razorpay online checkout button. Leave empty until the Cloud
# Functions are deployed and Razorpay keys are set (see docs/razorpay-setup.md).
VITE_ONLINE_PAYMENTS=

# Android app only: origin of the deployed site whose /api routes it calls.
VITE_API_ORIGIN=https://crewday.nirmaansolutions.in

# Merchant details for the policy pages (Razorpay review). Phone and address are hidden until set.
VITE_OPERATOR_NAME=Akshata Tirupati Rathod
VITE_GRIEVANCE_OFFICER=
VITE_SUPPORT_PHONE=
VITE_BUSINESS_ADDRESS=
