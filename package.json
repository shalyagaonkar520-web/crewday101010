{
  "name": "crew-day-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "lint": "oxlint",
    "emulators": "firebase emulators:start",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes,storage",
    "deploy:functions": "firebase deploy --only functions",
    "deploy": "npm run build && firebase deploy",
    "test:rules": "firebase emulators:exec --only firestore --project crewday-rules-test \"vitest run --project rules\"",
    "test": "npm run test:dom && npm run test:rules",
    "test:dom": "vitest run --project dom",
    "rules:dev": "node scripts/use-rules.mjs dev && firebase deploy --only firestore:rules,storage",
    "rules:prod": "node scripts/use-rules.mjs prod && firebase deploy --only firestore:rules,firestore:indexes,storage"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "firebase": "^12.19.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.47.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
